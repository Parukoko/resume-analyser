# Default: Gemini free tier via its OpenAI-compatible endpoint. Get a free API
# key at https://aistudio.google.com/apikey (no billing required for the free
# tier — gemini-3.6-flash: 10 requests/min, 1500/day as of writing). Google
# retires/renames free-tier models periodically; if you get a 404 "no longer
# available" error, check https://ai.google.dev/gemini-api/docs/models for the
# current model name and update this.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your-google-ai-studio-api-key
LLM_TEMPERATURE=0.2
# Per-call timeout (seconds) for both the LLM and embedding calls. 60s is
# generous for a cloud model. If you switch to a local CPU-only model instead
# (see "Alternative: local LLM" below), raise this a lot — CPU inference of an
# 8B model with no GPU can take several hundred seconds per call.
LLM_TIMEOUT=60
# OpenAI SDK default is 2 retries per call, which multiplies the effective wait
# (up to 3x LLM_TIMEOUT) before a slow/failing backend surfaces an error. Keep
# at 0 for predictable fail-fast behavior unless you specifically want
# retry-on-timeout (e.g. to ride out transient rate-limit errors).
LLM_MAX_RETRIES=0

# Embedding model for the hybrid semantic-similarity signal. gemini-embedding-001
# is served by the same OpenAI-compatible endpoint/API key as the LLM above.
EMBEDDING_MODEL=gemini-embedding-001
# Weight given to the embedding signal when blending into each category's score
# (0 = LLM-only, 1 = embedding-only). LLM score keeps weight (1 - this).
SEMANTIC_WEIGHT=0.2

MAX_UPLOAD_MB=10
OCR_FALLBACK_CHAR_THRESHOLD=20
# Where uploaded resumes are saved, named <uuid>.pdf, served back at GET /resumes/{id}.
UPLOAD_DIR=data/uploads

# streamlit_app.py only: how long the UI waits for a /analyze-resume response.
# Should comfortably exceed 2x LLM_TIMEOUT (embedding call + LLM call).
API_REQUEST_TIMEOUT=180

# --- Alternative: local LLM (Ollama) instead of Gemini ---
# Uncomment these and run `docker compose --profile local-llm up -d` (or run
# Ollama yourself locally). See README "Alternative: local LLM (Ollama)".
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
# LLM_TIMEOUT=1200
# EMBEDDING_MODEL=nomic-embed-text
